{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Deploy config for hosting Sal Marinho on your own Cloudflare account.
  // (wrangler.jsonc is the Higgsfield build config; this file is separate so
  // the two never interfere.) Deploy with: bash scripts/deploy-cloudflare.sh
  "name": "salmarinho",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": { "HF_ENV": "production", "APP_SLUG": "salmarinho" },

  // Static files (dist/client: built JS and CSS, images, film, fonts). The
  // deploy script uploads them here and src/lib/kv-static.server.ts serves them.
  "kv_namespaces": [{ "binding": "STATIC", "id": "68c74c23092f46db942e4f4e03679364" }],

  // Menu, journal, events, settings, reservations and admin sessions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salmarinho-db",
      "database_id": "5be3f5ff-76bd-46f3-9d85-a145461ea480",
      "migrations_dir": "migrations"
    }
  ],

  // Photos uploaded from the admin panel, served at /media/... The deploy
  // script leaves this out while R2 is not turned on for the account.
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "salmarinho-media" }]
}
